{
  "expo": {
    "name": "Vidya Poshak",
    "slug": "VidyaPoshak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "scheme": "VPApp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Logo.png",
      "bundleIdentifier": "com.vidyaposhak.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to take house visit photos.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to upload house visit photos."
      }
    },
    "android": {
      "package": "com.vidyaposhak.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/Logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs photo library access to upload house visit photos.",
          "cameraPermission": "This app needs camera access to take house visit photos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44fcbca0-20f3-4ba7-99f0-296d27988786"
      }
    },
    "owner": "amoghphadnis20"
  }
}
